.cache
.DS_Store
.vscode
.venv
__pycache__

# the binary and its objects
/snape
build

# third-party sources built in place (lcptools, Badread, ...) and generated benchmark data
lib
simulation
outputs

# Real HiFi pairs: hundreds of GB of reads, graphs and the CASTLE archive. The shell that fetches
# them IS source, so it stays. (A trailing comment on the pattern line does not work -- git reads it
# as part of the pattern, which is why this directory was untracked rather than ignored.)
/hifi/*
!/hifi/*.sh

# the paper: source is tracked, LaTeX build products are not
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# claude workspace (contains git worktrees)
.claude
