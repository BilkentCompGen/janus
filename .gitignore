# build products and fetched dependencies (make fetches rapidgzip into lib/)
/build/
/lib/
/.venv-bench/
__pycache__/

# references, built by ref/build.sh
/ref/*
!/ref/build.sh

# data: the reads and truth sets fetched by datasets/fetch.sh, the simulation's genomes and reads (datasets/simulate.sh)
/datasets/hifi/
/datasets/simulation/.venv/
/datasets/simulation/genomes/
/datasets/simulation/reads/
/datasets/simulation/ref/
/datasets/simulation/logs/
/datasets/simulation/spec/cosmic/

# benchmark results and environments (the scripts that make them are tracked)
/bench/runs/
/bench/runs_clean/
/bench/eval_sets/
/bench/eval_loo/
/bench/verdict/
/bench/supp/
/bench/callers/env/
/bench/callers/ref/
/bench/svb2fq
/bench/out/
/bench/figures.log

# LaTeX build products of the paper
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.bbl
/paper/*.blg
/paper/*.pdf
/paper/*.synctex.gz

.claude/
.DS_Store
.vscode
