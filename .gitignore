.cache
.DS_Store
.vscode
.venv
.venv-callers
.venv-svision
__pycache__

# the binary and its objects
/snape
build

# third-party sources built in place (Badread, ...) and generated benchmark data; lcptools (packed) is vendored
lib/*
!lib/lcptools/
lib/lcptools/liblcptools.a
lib/lcptools/config.h
simulation
outputs

# Real HiFi pairs: hundreds of GB of reads, graphs and the CASTLE archive. The shell that fetches
# them IS source, so it stays. (A trailing comment on the pattern line does not work -- git reads it
# as part of the pattern, which is why this directory was untracked rather than ignored.)
/hifi/*
!/hifi/*.sh

# the paper: source is tracked, LaTeX build products are not
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# claude workspace (contains git worktrees)
.claude

# Assembly and read alignments plus the consensus workspace: BAMs of several GB each and the caller
# outputs derived from them. All of it regenerates from scripts that ARE tracked, and `git add -A`
# pulled the BAMs in once already, which is what this rule prevents.
/asm2asm
/readalign
/consensus
/asm_somatic
/castle_res
/castle_delly
/overnight

# Buyuk ara ciktilar tmp/ altinda toplaniyor. Eski konumlarinda birer symlink var ki
# overnight/ altindaki betikler yollarini degistirmeden calissin.
/tmp

# Gece deneylerinin HAM minda ciktilari: dizin basina ~30 MB destek tablosu, toplam ~1.9 GB.
# Hepsi tmp/night/ altindaki betiklerden yeniden uretilebiliyor. Git'e giren yalniz ozet
# TSV/JSON'lar, figurler ve deney kayitlari.
/results/exp5b/
/results/exp2/
/results/exp2_hcc1937/
/results/exp1/
archive/
paper/measure/out/

# side builds (make BUILD=build4 ...) used to keep a variant binary next to the main one
/build*/

# benchmark outputs (the harness scripts in bench/ are tracked), and the reference data (hg38 fasta, minimap2 index,
# core index, VNTR bed)
/bench/out/
/bench/runs/
/ref/

# figure scripts cache the tables they computed from the runs; the scripts rebuild them
paper/figures/snape/*/cache/
paper/figures/snape/*/__pycache__/
