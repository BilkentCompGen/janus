.cache
.DS_Store
.vscode
.venv
.venv-callers
.venv-svision
__pycache__

# the binary and its objects
/snape
build

# third-party sources built in place (lcptools, Badread, ...) and generated benchmark data
lib
simulation
outputs

# Real HiFi pairs: hundreds of GB of reads, graphs and the CASTLE archive. The shell that fetches
# them IS source, so it stays. (A trailing comment on the pattern line does not work -- git reads it
# as part of the pattern, which is why this directory was untracked rather than ignored.)
/hifi/*
!/hifi/*.sh

# the paper: source is tracked, LaTeX build products are not
paper/*.aux
paper/*.log
paper/*.out
paper/*.pdf
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# claude workspace (contains git worktrees)
.claude

# Assembly and read alignments plus the consensus workspace: BAMs of several GB each and the caller
# outputs derived from them. All of it regenerates from scripts that ARE tracked, and `git add -A`
# pulled the BAMs in once already, which is what this rule prevents.
/asm2asm
/readalign
/consensus
/asm_somatic
/castle_res
/castle_delly
/overnight

# Buyuk ara ciktilar tmp/ altinda toplaniyor. Eski konumlarinda birer symlink var ki
# overnight/ altindaki betikler yollarini degistirmeden calissin.
/tmp
